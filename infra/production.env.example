IOT_EDGE_VERSION=0.1.0
IOT_EDGE_BACKEND_IMAGE=iot-edge-backend
IOT_EDGE_FRONTEND_IMAGE=iot-edge-frontend
IOT_EDGE_HTTP_PORT=80
IOT_EDGE_BACKEND_PORT=8080

POSTGRES_USER=iotedge
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=iotedge
POSTGRES_PORT=5432

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
LOG_LEVEL=info
CORS_ALLOW_ORIGINS=http://iot-edge.local
COOKIE_SECURE=false
INTERNET_CHECK_ADDRESS=1.1.1.1:443
INTERNET_CHECK_TIMEOUT=2s

PUBLISHER_MASTER_KEY_ID=publisher-master-v1
PUBLISHER_MASTER_KEY_BASE64=replace-with-base64-encoded-32-random-bytes

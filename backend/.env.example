PORT=8080
ENV=development
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/iotedge?sslmode=disable
JWT_SECRET=your-secret-key-here-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
LOG_LEVEL=debug
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://iot-edge.home.arpa:5173
COOKIE_SECURE=false
INTERNET_CHECK_ADDRESS=1.1.1.1:443
INTERNET_CHECK_TIMEOUT=2s

# Optional until Data Publisher secrets/runtime are enabled. Generate 32 random
# bytes externally and store only the base64 value in the deployment secret store.
PUBLISHER_MASTER_KEY_ID=publisher-master-v1
PUBLISHER_MASTER_KEY_BASE64=
